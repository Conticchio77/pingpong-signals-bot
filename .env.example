# ⚠️ NON committare mai questo file su GitHub!
# Inserisci queste variabili direttamente su Railway → Variables

# Token del bot Telegram (da @BotFather) — REVOCA se già esposto in chat
TELEGRAM_BOT_TOKEN=INSERISCI_QUI_IL_NUOVO_TOKEN

# Il tuo Telegram ID
ADMIN_ID=858001417

# ID canale VIP (usato solo quando premi "Invia al VIP")
VIP_GROUP_ID=-1002950341972

# ── The Odds API (CONSIGLIATO — quote reali dai book) ──────────────────────────
# Registrati GRATIS su https://the-odds-api.com → 500 richieste/mese gratuite
# Copia la tua API Key qui sotto
ODDS_API_KEY=

# ── Anthropic Claude API (OPZIONALE — analisi AI avanzata) ────────────────────
# Senza questa chiave il bot usa l'analisi euristica automatica (funziona lo stesso)
ANTHROPIC_API_KEY=

# Percorso database SQLite
# Su Railway: aggiungi un Volume con mount /data e usa: DB_PATH=/data/signals.db
DB_PATH=signals.db
